<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /study/

  # Pass /study/api/* requests directly to PHP scripts without SPA rewriting
  RewriteRule ^api/ - [L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other /study/* client routes to index.html for React Router
  RewriteRule . /study/index.html [L]
</IfModule>

# Security & Performance Headers for Hostinger Apache
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Increase PHP upload limits for PDF and slide image multimodal study materials
<IfModule mod_php.c>
  php_value upload_max_filesize 32M
  php_value post_max_size 40M
  php_value max_execution_time 120
</IfModule>

